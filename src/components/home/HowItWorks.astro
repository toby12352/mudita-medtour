---
/*
 * Six-step patient journey for the home page. One column with a dashed rail below `lg`;
 * two rows of three joined by a dashed line from `lg`. Rows keep reading order 1-2-3, 4-5-6.
 */
import Container from '../ui/Container.astro';
import { getLocale, useTranslations, type UiKey } from '../../i18n/ui';

const locale = getLocale(Astro.currentLocale);
const t = useTranslations(locale);

const icons = {
  contact: '<path d="M7.9 20A9 9 0 1 0 4 16.1L2 22Z" /><path d="M8 12h.01M12 12h.01M16 12h.01" />',
  planning:
    '<rect x="5" y="4" width="14" height="18" rx="2" /><path d="M9 2h6v4H9zM9 11h6M9 15h6M9 19h3" />',
  travel:
    '<path d="M17.8 19.2 16 11l3.5-3.5C21 6 21.5 4 21 3c-1-.5-3 0-4.5 1.5L13 8 4.8 6.2c-.5-.1-.9.1-1.1.5l-.3.5c-.2.5-.1 1 .3 1.3L9 12l-2 3H4l-1 1 3 2 2 3 1-1v-3l3-2 3.5 5.3c.3.4.8.5 1.3.3l.5-.2c.4-.3.6-.7.5-1.2Z" />',
  procedure: '<path d="M22 12h-4l-3 9L9 3l-3 9H2" />',
  postOp: '<path d="M2 4v16M2 8h18a2 2 0 0 1 2 2v10M2 17h20M6 8v9" />',
  followUp:
    '<rect x="3" y="4" width="18" height="18" rx="2" /><path d="M16 2v4M8 2v4M3 10h18M9 16l2 2 4-4" />',
} as const;

const steps: { icon: keyof typeof icons; title: UiKey; text: UiKey }[] = [
  { icon: 'contact', title: 'home.steps.contact', text: 'home.steps.contactText' },
  { icon: 'planning', title: 'home.steps.planning', text: 'home.steps.planningText' },
  { icon: 'travel', title: 'home.steps.travel', text: 'home.steps.travelText' },
  { icon: 'procedure', title: 'home.steps.procedure', text: 'home.steps.procedureText' },
  { icon: 'postOp', title: 'home.steps.postOp', text: 'home.steps.postOpText' },
  { icon: 'followUp', title: 'home.steps.followUp', text: 'home.steps.followUpText' },
];

const perRow = 3;
---

<section aria-labelledby="how-it-works-heading" class="bg-surface-muted border-border border-b">
  <Container class="py-16">
    <div class="text-center">
      <h2 id="how-it-works-heading">{t('home.steps.title')}</h2>
      <div class="bg-primary-700 mx-auto mt-4 h-0.5 w-12" aria-hidden="true"></div>
      <p class="text-ink-muted mx-auto mt-6 max-w-2xl text-lg">{t('home.steps.lead')}</p>
    </div>

    <ol class="mx-auto mt-12 max-w-2xl pt-4 lg:grid lg:max-w-none lg:grid-cols-3 lg:gap-x-6 lg:gap-y-16">
      {steps.map((step, index) => {
        const isLast = index === steps.length - 1;
        const endsRow = index % perRow === perRow - 1;
        return (
          <li class="relative flex gap-5 pb-10 last:pb-0 lg:flex-col lg:items-center lg:gap-0 lg:pb-0 lg:text-center">
            {!isLast && (
              <span
                class="border-primary-700 absolute start-10 top-20 bottom-0 -ms-px border-s-2 border-dashed lg:hidden"
                aria-hidden="true"
              />
            )}
            {!endsRow && (
              /* Center of this tile to the center of the next: half a cell, plus the gap-x-6. */
              <span
                class="border-primary-700 absolute start-1/2 -end-1/2 top-10 -me-6 hidden border-t-2 border-dashed lg:block"
                aria-hidden="true"
              />
            )}
            <div class="bg-primary-700 rounded-card relative flex size-20 shrink-0 items-center justify-center text-white">
              <span
                class="bg-primary-700 ring-surface-muted absolute inset-x-0 -top-4 mx-auto flex size-8 items-center justify-center rounded-full text-sm font-semibold text-white ring-4"
                aria-hidden="true"
              >
                {index + 1}
              </span>
              <svg
                class="size-10"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <Fragment set:html={icons[step.icon]} />
              </svg>
            </div>
            <div class="min-w-0 pt-3 lg:mt-6 lg:max-w-xs lg:pt-0">
              <h3 class="break-words">{t(step.title)}</h3>
              <p class="text-ink-muted mt-2 break-words">{t(step.text)}</p>
            </div>
          </li>
        );
      })}
    </ol>
  </Container>
</section>
