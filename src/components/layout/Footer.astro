---
import BrandIcon from '../common/BrandIcon.astro';
import Container from '../ui/Container.astro';
import { getLocale, useTranslations } from '../../i18n/ui';
import { site, socialLinks } from '../../lib/site';

const locale = getLocale(Astro.currentLocale);
const t = useTranslations(locale);
const year = new Date().getFullYear();
---

<footer class="bg-primary-700 mt-16 text-white">
  <Container class="flex flex-col gap-2 py-3 sm:flex-row sm:items-center sm:justify-between">
    <p class="text-sm">
      &copy; {year} {site.name}
    </p>

    <ul
      aria-label={t('footer.social')}
      class="-me-3 flex items-center self-end sm:self-auto sm:border-s sm:border-white/30 sm:ps-2"
    >
      {
        socialLinks.map((link) => (
          <li>
            <a
              href={link.href}
              class="rounded-control hover:text-secondary inline-flex size-11 items-center justify-center text-white focus-visible:outline-white"
            >
              <BrandIcon name={link.network} class="size-5" />
              <span class="sr-only">{t(link.labelKey)}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </Container>
</footer>
