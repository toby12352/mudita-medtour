---
import ArticleCard from '../components/common/ArticleCard.astro';
import HowItWorks from '../components/home/HowItWorks.astro';
import Skyline from '../components/home/Skyline.astro';
import Button from '../components/ui/Button.astro';
import Container from '../components/ui/Container.astro';
import { getLocale, localizePath, useTranslations } from '../i18n/ui';
import MainLayout from '../layouts/MainLayout.astro';
import { getPublishedArticles } from '../lib/articles';
import { site } from '../lib/site';

const locale = getLocale(Astro.currentLocale);
const t = useTranslations(locale);
const articlesUrl = localizePath(locale, '/articles/');
const latestArticles = (await getPublishedArticles(locale)).slice(0, 3);
---

<MainLayout>
  <section class="bg-secondary-50 border-secondary min-h-first-screen flex flex-col border-b lg:grid lg:min-h-0 lg:grid-cols-2 xl:grid-cols-5">
    <div class="relative min-h-48 flex-1 sm:min-h-72 lg:min-h-0 xl:col-span-3">
      <div class="hidden lg:block lg:aspect-16/10"></div>
      <Skyline />
    </div>
    <div class="border-secondary flex flex-col justify-center border-t-4 py-8 sm:py-12 lg:order-first lg:border-e-4 xl:col-span-2 lg:border-t-0">
      <Container>
        <p class="text-primary-700 font-medium">{site.name}</p>
        <h1 class="mt-3">{t('home.heroTitle')}</h1>
        <p class="text-ink-muted mt-6 max-w-2xl text-lg sm:text-xl">{t('site.description')}</p>
        <Button href={articlesUrl} size="lg" class="mt-8 w-full sm:w-auto">
          {t('home.readArticles')}
        </Button>
      </Container>
    </div>
  </section>

  <HowItWorks />

  {latestArticles.length > 0 && (
    <section aria-labelledby="latest-articles-heading">
      <Container class="py-16">
        <div class="flex items-end justify-between gap-4">
          <h2 id="latest-articles-heading">{t('home.latestArticles')}</h2>
          <a href={articlesUrl} class="text-primary-700 hover:text-accent font-medium">
            {t('home.viewAll')}
          </a>
        </div>
        <ul class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {latestArticles.map((article) => (
            <li>
              <ArticleCard article={article} headingLevel="h3" />
            </li>
          ))}
        </ul>
      </Container>
    </section>
  )}
</MainLayout>
